rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isLinkedParent(childId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/children/$(childId)).data.parent_reference_ids;
    }

    match /energy_bridge/{childId} {
      allow read: if isLinkedParent(childId);
      allow create, update: if isLinkedParent(childId) &&
        request.resource.data.updated_by == request.auth.uid;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}