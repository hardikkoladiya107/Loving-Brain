rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isLinkedParent(childId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/children/$(childId)).data.parent_reference_ids;
    }

    // Energy Bridge: only linked parents can read and update/delete
    match /energy_bridge/{childId} {
      allow read: if isLinkedParent(childId);
      allow create, update: if isLinkedParent(childId) &&
        request.resource.data.updated_by == request.auth.uid;
      allow delete: if isLinkedParent(childId);
    }

    // OTP codes: permanently locked from all client SDKs (Cloud Functions use Admin SDK)
    match /otps/{email} {
      allow read, write: if false;
    }

    // Co-parent invitations: allow single get for invite links without login; list/write requires auth
    match /co-parent-invitation/{invitationId} {
      allow get: if true;
      allow list, write: if isSignedIn();
    }

    // User profiles & user subcollections
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
      match /{allChildren=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Children & child subcollections (sleep_logs, behaviours, experiments, events)
    // Only linked parents can read and modify child records (Doc 01 & Doc 06 §7)
    match /children/{childId} {
      allow read: if isLinkedParent(childId);
      allow create: if isSignedIn();
      allow update, delete: if isLinkedParent(childId);
      match /{allChildren=**} {
        allow read, write: if isLinkedParent(childId);
      }
    }

    // Shared family events
    match /shared_event/{id} {
      allow read, write: if isSignedIn();
    }

    // Behaviour category definitions
    match /behaviours/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Static parenting content (read-only)
    match /dailyParentingTips/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /learn_and_play_prompts/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Mentorship & milestones
    match /milestones/{id} {
      allow read, write: if isSignedIn();
      match /{allChildren=**} {
        allow read, write: if isSignedIn();
      }
    }

    match /mentorship_requests/{id} {
      allow read, write: if isSignedIn() &&
        (resource == null || resource.data.parent_id == request.auth.uid || request.resource.data.parent_id == request.auth.uid);
    }

    match /mentorship_waitlist/{id} {
      allow read, write: if isSignedIn() &&
        (resource == null || resource.data.user_id == request.auth.uid || request.resource.data.user_id == request.auth.uid);
    }

    match /enrolled_programs/{id} {
      allow read, write: if isSignedIn();
    }

    match /post_session_plans/{id} {
      allow read, write: if isSignedIn();
    }
  }
}